# OpenAI (primary). If OPENAI_API_KEY is set it is used before LLM_API_URL and Ollama.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=low

# Ollama (fallback when no OpenAI key / remote URL)
OLLAMA_MODEL=llama3.1:8b-instruct-q4_0
OLLAMA_BASE_URL=http://localhost:11434

# Remote LLM (used when there is no OPENAI_API_KEY; takes precedence over Ollama)
LLM_API_URL=https://leslie-las-lets-referrals.trycloudflare.com/chat
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# Dataset
EXERCISES_DATASET_URL=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/data/exercises.json

# Paths (relative to back/)
DATABASE_PATH=data/app.db
GENERATIONS_DIR=data/generations

# --- Docker / Coolify deploy ---
# Only needed if a browser calls the API directly from another origin
# (the Next.js /api proxy makes it unnecessary in normal use).
CORS_ORIGINS=http://localhost:3000
