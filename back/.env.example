# Ollama
OLLAMA_MODEL=llama3.1:8b-instruct-q4_0
OLLAMA_BASE_URL=http://localhost:11434

# Remote LLM (if LLM_API_URL is set, it is used instead of Ollama)
LLM_API_URL=https://leslie-las-lets-referrals.trycloudflare.com/chat
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# Dataset
EXERCISES_DATASET_URL=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/data/exercises.json

# Paths (relative to back/)
DATABASE_PATH=data/app.db
GENERATIONS_DIR=data/generations

# --- Docker / Coolify deploy ---
# Public URL of the frontend (CORS) and of the API (baked into the frontend at build time)
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001
